# Committed non-model Docker smoke profile (safe to ship; no secrets).
# Used by Dockerfile / scripts/smoke_docker.ps1. Local Windows fast-check still
# uses the gitignored backend/.env.fast-check generated on the host.

APP_NAME=ai-image-edit
APP_VERSION=0.1.0
APP_COMMIT=dev
FRONTEND_ORIGIN=http://localhost:3000
OFFLINE_MODE=1
DEBUG=0

OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

MODEL_ROOT=./models/hf
DB_PATH=./data/app.fast-check.db

MAX_WIDTH=512
MAX_HEIGHT=512
MAX_STEPS=12
MAX_UPLOAD_MB=10
MAX_CONCURRENT_JOBS=1

INFERENCE_MODE=local
WORKER_URL=http://127.0.0.1:8001
WORKER_CALLBACK_URL=http://127.0.0.1:8000
WORKER_HEALTH_TIMEOUT_SEC=2

WARMUP_MODELS=0
WARMUP_TIMEOUT_SEC=60
SAFETY_REVIEW_MODE=manual
QUALITY_PROFILE=cpu-low

ENABLED_MODELS=qwen-image-2512

DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512
DEFAULT_STEPS=8

ENABLE_ATTENTION_SLICING=1
ENABLE_VAE_SLICING=1
ENABLE_VAE_TILING=0
